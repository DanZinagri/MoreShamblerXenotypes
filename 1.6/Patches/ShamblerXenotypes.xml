							<Seertusk MayRequire="biotexpans.mammalia">0.005</Seertusk>
							<Cloudpuff MayRequire="biotexpans.mammalia">0.005</Cloudpuff>
							<BS_Jotun MayRequire="RedMattis.BigSmall">0.0005</BS_Jotun>
							<BS_LesserOni MayRequire="RedMattis.Yokai">0.0005</BS_LesserOni>
							<BS_Half_Jotun MayRequire="RedMattis.BigSmall">0.0005</BS_Half_Jotun>
							<BS_Abomination MayRequire="RedMattis.MoreXenos">0.0005</BS_Abomination>
							<LoS_Adderman MayRequire="RedMattis.LamiasAndOtherSnakes">0.005</LoS_Adderman>
							<LoS_Anacondaman MayRequire="RedMattis.LamiasAndOtherSnakes">0.0005</LoS_Anacondaman>
