							<BS_Ymir MayRequire="RedMattis.BigSmall">0.0005</BS_Ymir>
							<BS_Kitsune MayRequire="RedMattis.Yokai">0.005</BS_Kitsune>
							<BS_Nekomata MayRequire="RedMattis.Yokai">0.005</BS_Nekomata>
							<BS_Ogre MayRequire="RedMattis.BigSmall">0.0005</BS_Ogre>
							<BS_GreatOgre MayRequire="RedMattis.BigSmall">0.0005</BS_GreatOgre>
							<BS_Broodmother MayRequire="RedMattis.MoreXenos">0.0005</BS_Broodmother>
							<Genie>0.01</Genie>
