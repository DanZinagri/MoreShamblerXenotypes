	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="sarg.alphagenes">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>Defs/PawnKindDef[@Name="ShamblerBase"]/xenotypeSet/xenotypeChances</xpath>
						<value>
							<Devilpuff MayRequire="biotexpans.mammalia">0.001</Devilpuff>
							<LoS_ScenarioTiamat MayRequire="RedMattis.LamiasAndOtherSnakes">0.0005</LoS_ScenarioTiamat>
							<BS_HiveQueen MayRequire="RedMattis.MoreXenos">0.0005</BS_HiveQueen>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Cybranian - Anomaly Ghosts</li>
				</mods>
				<match Class="PatchOperationSequence">
					<operations>
						<li Class="PatchOperationAdd">
							<xpath>Defs/PawnKindDef[defName="Ghost"]</xpath>
							<value>
								<xenotypeSet Inherit="False">
									<xenotypeChances>
										<!-- dull -->
										<Yttakin>0.01</Yttakin>
										<Uredd MayRequire="Rimsenal.Askbarn">0.01</Uredd>
										<!-- normal -->
										<Baseliner>0.20</Baseliner>
										<Starjack MayRequire="Ludeon.RimWorld.Odyssey">0.02</Starjack>
										<Genie>0.02</Genie>
										<Dirtmole>0.02</Dirtmole>
										<Waster>0.02</Waster>
										<Neanderthal>0.02</Neanderthal>
										<VRESaurids_Saurid MayRequire="vanillaracesexpanded.saurid">0.01</VRESaurids_Saurid>
										<VRE_Lowmate MayRequire="vanillaracesexpanded.highmate">0.01</VRE_Lowmate>
										<Askbarn MayRequire="Rimsenal.Askbarn">0.02</Askbarn>
										<Harana MayRequire="Rimsenal.Harana">0.02</Harana>
										<AG_Forsaken MayRequire="sarg.alphagenes">0.02</AG_Forsaken>
										<DV_Halffoot MayRequire="det.halffoot">0.02</DV_Halffoot>
										<DV_Brawnum MayRequire="det.brawnum">0.02</DV_Brawnum>
										<Barkkin MayRequire="biotexpans.mammalia">0.01</Barkkin>
										<Bonecrown MayRequire="biotexpans.mammalia">0.01</Bonecrown>
										<Wiretail MayRequire="biotexpans.mammalia">0.01</Wiretail>
										<Hidewing MayRequire="biotexpans.mammalia">0.01</Hidewing>
										<Haytankard MayRequire="biotexpans.mammalia">0.01</Haytankard>
										<Hindhopper MayRequire="biotexpans.mammalia">0.01</Hindhopper>
										<Cloudpuff MayRequire="biotexpans.mammalia">0.01</Cloudpuff>
